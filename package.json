{
  "name": "commerce-intelligence-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && node scripts/check-worker-bundle.mjs && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/check-worker-bundle.mjs && wrangler deploy",
    "lint": "eslint",
    "test:ai": "node --experimental-strip-types --test lib/ai/*.test.ts",
    "test:catalog": "node --experimental-strip-types --import ./test/register.mjs --test lib/data/*.test.ts lib/catalog/*.test.ts",
    "test:auth": "node --experimental-strip-types --test lib/auth/*.test.ts",
    "test:buyer": "node --experimental-strip-types --import ./test/register.mjs --test lib/db/*.test.ts",
    "test:analytics": "node --experimental-strip-types --import ./test/register.mjs --test lib/analytics/*.test.ts lib/routes/*.test.ts lib/analytics/adapters/*.test.ts",
    "test": "node --experimental-strip-types --import ./test/register.mjs --test lib/ai/*.test.ts lib/data/*.test.ts lib/catalog/*.test.ts lib/auth/*.test.ts lib/db/*.test.ts lib/analytics/*.test.ts lib/routes/*.test.ts lib/analytics/adapters/*.test.ts",
    "test:integration": "node --test test/integration/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "check:worker": "node scripts/check-worker-bundle.mjs",
    "images:build": "node scripts/build-product-images.mjs",
    "images:fetch": "node scripts/images/fetch-sources.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.6.0",
    "wrangler": "^4.113.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "three": "^0.186.1",
    "typescript": "^5"
  }
}
